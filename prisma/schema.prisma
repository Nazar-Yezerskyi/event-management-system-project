generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categories {
  id                  Int                   @id @default(autoincrement())
  name                String
  createdAt           DateTime              @default(now())
  CompaniesCategories CompaniesCategories[]
  UsersCategories     UsersCategories[]
}

model Companies {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String                @unique
  createdAt           DateTime              @default(now())
  country             String
  city                String
  street              String
  userId              Int
  isVerified          Boolean               @default(false)
  Comments            Comments[]
  Users               Users                 @relation(fields: [userId], references: [id])
  CompaniesCategories CompaniesCategories[]
  Events              Events[]
  News                News[]
  NewsSubscription    NewsSubscription[]
  PromoCodes          PromoCodes[]
  Requests            Requests[]
  Chats Chats[]
}

model CompaniesCategories {
  id         Int        @id @default(autoincrement())
  categoryId Int
  companyId  Int
  addedAt    DateTime   @default(now())
  Categories Categories @relation(fields: [categoryId], references: [id])
  Companies  Companies  @relation(fields: [companyId], references: [id])
}

model Events {
  id                  Int           @id @default(autoincrement())
  status              String        @default("active")
  eventImg            String
  name                String
  ticket_price        Float
  date                DateTime
  duration_in_minutes Int
  start_time          DateTime
  description         String
  place_of_event      String
  country             String
  city                String
  street              String
  number_of_seats     Int
  companyId           Int
  Comments            Comments[]
  Companies           Companies     @relation(fields: [companyId], references: [id])
  EventsTypes         EventsTypes[]
  OrderTicket         OrderTicket[]
  Places              Places[]
  PromoCodes          PromoCodes[]
}

model EventsTypes {
  id                     Int                  @id @default(autoincrement())
  typeOfEventsActivityId Int
  eventId                Int
  Events                 Events               @relation(fields: [eventId], references: [id])
  TypeOfEventsActivity   TypeOfEventsActivity @relation(fields: [typeOfEventsActivityId], references: [id])
}

model News {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  newsImg   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  companyId Int
  Companies Companies @relation(fields: [companyId], references: [id])
}

model NewsSubscription {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  getEmail  Boolean   @default(true)
  userId    Int
  companyId Int
  Companies Companies @relation(fields: [companyId], references: [id])
  Users     Users     @relation(fields: [userId], references: [id])
}

model OrderPlaces {
  id            Int         @id @default(autoincrement())
  orderTicketId Int
  placeId       Int
  OrderTicket   OrderTicket @relation(fields: [orderTicketId], references: [id])
  Places        Places      @relation(fields: [placeId], references: [id])
}

model OrderTicket {
  id                Int           @id @default(autoincrement())
  totalPrice        Float
  createdAt         DateTime      @default(now())
  isPaid            Boolean       @default(false)
  eventId           Int
  userId            Int
  showParticipation Boolean       @default(true)
  promoCode         String?
  OrderPlaces       OrderPlaces[]
  Events            Events        @relation(fields: [eventId], references: [id])
  Users             Users         @relation(fields: [userId], references: [id])
  Payment           Payment[]
}

model Places {
  id          Int           @id @default(autoincrement())
  row         Int
  seatNumber  Int
  eventId     Int
  OrderPlaces OrderPlaces[]
  Events      Events        @relation(fields: [eventId], references: [id])
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  Users Users[]
}

model TypeOfEventsActivity {
  id          Int           @id @default(autoincrement())
  name        String
  createdAt   DateTime      @default(now())
  EventsTypes EventsTypes[]
}

model Users {
  id                                  Int                @id @default(autoincrement())
  userImg                             String?
  firstName                           String
  lastName                            String
  password                            String
  email                               String             @unique
  createdAt                           DateTime           @default(now())
  accountImg                          String?
  lastLogIn                           DateTime?          @db.Timestamp(6)
  isVerified                          Boolean            @default(false)
  verificationToken                   String?
  roleId                              Int
  Comments                            Comments[]
  Companies                           Companies[]
  Follows_Follows_followedByIdToUsers Follows[]          @relation("Follows_followedByIdToUsers")
  Follows_Follows_followingIdToUsers  Follows[]          @relation("Follows_followingIdToUsers")
  NewsSubscription                    NewsSubscription[]
  OrderTicket                         OrderTicket[]
  Payment                             Payment[]
  createdBy                           Requests[]         @relation("createdBy")
  reviewdBy                           Requests[]         @relation("reviewdBy")
  Roles                               Roles              @relation(fields: [roleId], references: [id])
  UsersCategories                     UsersCategories[]
  ChatParticipants ChatParticipants[]
  Messages Messages[]
  SurveyResponses SurveyResponses[]
}

model UsersCategories {
  id         Int        @id @default(autoincrement())
  userId     Int
  categoryId Int
  addedAt    DateTime   @default(now())
  Categories Categories @relation(fields: [categoryId], references: [id])
  Users      Users      @relation(fields: [userId], references: [id])
}

model PromoCodes {
  id              Int       @id @default(autoincrement())
  code            String
  discountPercent Float
  maxUsages       Int?
  usages          Int       @default(0)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  eventId         Int?
  companyId       Int
  description     String
  minOrderPrice   Int?
  Companies       Companies @relation(fields: [companyId], references: [id])
  Events          Events?   @relation(fields: [eventId], references: [id])
}

model Requests {
  id          Int        @id @default(autoincrement())
  type        String
  status      String     @default("pending")
  companyId   Int?
  data        Json
  createdAt   DateTime   @default(now())
  reviewdAt   DateTime?
  reviewdById Int?
  createdById Int
  description String
  Companies   Companies? @relation(fields: [companyId], references: [id])
  createdBy   Users      @relation("createdBy", fields: [createdById], references: [id])
  reviewdBy   Users?     @relation("reviewdBy", fields: [reviewdById], references: [id])
}

model Comments {
  id        Int       @id @default(autoincrement())
  userId    Int
  addedAt   DateTime  @default(now())
  image     String?
  updatedAt DateTime?
  companyId Int
  eventId   Int?
  content   String
  Companies Companies @relation(fields: [companyId], references: [id])
  Events    Events?   @relation(fields: [eventId], references: [id])
  Users     Users     @relation(fields: [userId], references: [id])
}

model Payment {
  id              Int         @id @default(autoincrement())
  orderTicketId   Int
  paymentMethod   String
  amount          Int
  currency        String
  status          String      @default("in progress")
  paymentIntentId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime?
  userId          Int
  OrderTicket     OrderTicket @relation(fields: [orderTicketId], references: [id])
  Users           Users       @relation(fields: [userId], references: [id])
}

model Follows {
  id                                Int       @id @default(autoincrement())
  followedById                      Int
  followingId                       Int
  status                            String    @default("pending")
  updatedAt                         DateTime?
  addedDate                         DateTime  @default(now())
  Users_Follows_followedByIdToUsers Users     @relation("Follows_followedByIdToUsers", fields: [followedById], references: [id])
  Users_Follows_followingIdToUsers  Users     @relation("Follows_followingIdToUsers", fields: [followingId], references: [id])
}

model Chats {
  id          Int               @id @default(autoincrement())
  name        String?
  isActive Boolean @default(true)
  createdAt   DateTime          @default(now())
  createdByCompanyId Int
  company Companies @relation(fields: [createdByCompanyId], references: [id])
  participants ChatParticipants[]
  messages    Messages[]
}

model ChatParticipants {
  id       Int    @id @default(autoincrement())
  chatId   Int
  userId   Int
  joinedAt DateTime @default(now())
  chat     Chats  @relation(fields: [chatId], references: [id])
  user     Users  @relation(fields: [userId], references: [id])
}

model Messages {
  id        Int       @id @default(autoincrement())
  content   String    
  createdAt DateTime  @default(now())
  senderId  Int       
  chatId    Int       
  sender    Users     @relation(fields: [senderId], references: [id])
  chat      Chats     @relation(fields: [chatId], references: [id])
}

model Survey {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime  @default(now())
  createdByCompanyId Int
  expiresAt DateTime?
  showResult Boolean @default(true)
  surveyOptions SurveyOptions[]
  surveyResponses SurveyResponses[]

}

model SurveyOptions{
  id Int @id @default(autoincrement())
  text String
  surveyId Int
  Survey Survey @relation(fields: [surveyId], references: [id])
  surveyResponses SurveyResponses[]
}

model SurveyResponses{
  id Int @id @default(autoincrement())
  surveyId Int
  surveyOptionsId Int
  userId Int
  Survey Survey @relation(fields: [surveyId], references: [id])
  SurveyOptions SurveyOptions @relation(fields: [surveyOptionsId], references: [id])
  Users Users @relation(fields: [userId], references: [id])
}

